{
  "game_title": "Gem Collector Demo",
  "controls": {
    "move_left": "left arrow",
    "move_right": "right arrow",
    "restart": "R"
  },
  "eval": {
    "tests": [
      {
        "test_id": "MOVE-LEFT-001",
        "requirement_index": 0,
        "actions": [
          {"type": "key_down", "key": "left", "frames": 10},
          {"type": "key_up", "key": "left"}
        ],
        "observation": {"method": "read_player_position", "field": "x"},
        "expected": "Player x-coordinate decreases after left-arrow input.",
        "timeout_seconds": 10
      },
      {
        "test_id": "SCORE-GEM-001",
        "requirement_index": 1,
        "actions": [
          {"type": "set_test_state", "state": {"player_near_gem": true, "score": 0}},
          {"type": "press_key", "key": "right", "frames": 1}
        ],
        "observation": {"method": "read_game_state", "field": "score"},
        "expected": "Score equals 1 after one gem is collected.",
        "timeout_seconds": 10
      },
      {
        "test_id": "WIN-STATE-001",
        "requirement_index": 2,
        "actions": [
          {"type": "set_test_state", "state": {"score": 4, "player_near_gem": true}},
          {"type": "press_key", "key": "right", "frames": 1}
        ],
        "observation": {"method": "read_game_state", "field": "scene_state"},
        "expected": "Scene state equals win after the fifth gem is collected.",
        "timeout_seconds": 15
      },
      {
        "test_id": "RESTART-001",
        "requirement_index": 3,
        "actions": [
          {"type": "press_key", "key": "r", "frames": 1}
        ],
        "observation": {"method": "read_game_state", "field": "score_and_scene_state"},
        "expected": "Score resets to 0 and scene state returns to playing.",
        "timeout_seconds": 10
      }
    ]
  }
}
