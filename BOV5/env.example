# Copy this file to .env and fill in your own values. Never commit or share .env itself.

# --- Required: OpenRouter API keys (start with sk-or-) ---
# These three can all be the same key if you prefer; keeping them separate lets you
# track or limit cost per agent independently in OpenRouter.
PLANNER_OPENROUTER_API_KEY=sk-or-...
ASSET_OPENROUTER_API_KEY=sk-or-...
CODER_OPENROUTER_API_KEY=sk-or-...

# --- Godot (only required for Godot games) ---
# Absolute path to a Godot 4.x executable. Leave blank if you won't build Godot games.
GODOT_BINARY=

# --- Logic Coder budget (all optional; shown defaults are the code's own fallback) ---
# CODER_MODEL=google/gemini-2.5-flash
# CODER_MAX_STEPS=40
# CODER_MAX_SECONDS=1800
# CODER_MAX_TOKENS=450000
# CODER_MAX_COST_USD=
# CODER_COMMAND_TIMEOUT=120
# CODER_VERBOSE=

# --- Asset Agent (all optional) ---
# ASSET_GENERATION_MODE=
# ASSET_IMAGE_MODEL=
# ASSET_IMAGE_TIMEOUT=
